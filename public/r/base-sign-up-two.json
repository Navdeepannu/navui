{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "base-sign-up-two",
  "title": "Sign Up Two",
  "description": "A split-screen account creation flow with social sign-in, product benefits, and an animated visual.",
  "dependencies": [
    "cn",
    "lucide-react",
    "shaders"
  ],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "registry/blocks/base/sign-up/sign-up-two/sign-up-two.tsx",
      "content": "'use client'\n\nimport Link from 'next/link'\nimport { Shader, FilmGrain, Swirl, WaveDistortion } from 'shaders/react'\nimport type { SVGProps } from 'react'\n\nimport { Logo } from './sign-up-two-logo'\nimport { Button } from '@/components/ui/button'\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\n\nfunction GitHubIcon(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" {...props}>\n      <path d=\"M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.09 0 4.42-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z\" />\n    </svg>\n  )\n}\n\nexport default function SignUpTwo() {\n  return (\n    <section className=\"min-h-screen py-6 md:py-10\">\n      <div className=\"grid min-h-[calc(100vh-5rem)] grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-16\">\n        {/* Left side */}\n        <div className=\"flex w-full items-center justify-center px-4 md:h-170 md:pr-0 md:pl-8 lg:pl-16\">\n          <form className=\"w-full max-w-md\">\n            <div className=\"text-left\">\n              <Link href=\"/\" aria-label=\"Go home\" className=\"inline-flex w-fit\">\n                <Logo className=\"h-8 w-8 text-zinc-800 dark:text-zinc-100\" />\n              </Link>\n\n              <h1 className=\"mt-5 mb-1 text-2xl font-semibold tracking-tight\">\n                Create a Hexora Account\n              </h1>\n\n              <p className=\"text-sm text-muted-foreground\">\n                Welcome! Create an account to get started.\n              </p>\n            </div>\n\n            <div className=\"mt-8 space-y-6\">\n              <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n                <div className=\"space-y-2\">\n                  <Label htmlFor=\"firstname\" className=\"block text-sm\">\n                    First name\n                  </Label>\n                  <Input\n                    type=\"text\"\n                    placeholder=\"John\"\n                    required\n                    name=\"firstname\"\n                    id=\"firstname\"\n                    autoComplete=\"given-name\"\n                  />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <Label htmlFor=\"lastname\" className=\"block text-sm\">\n                    Last name\n                  </Label>\n                  <Input\n                    type=\"text\"\n                    placeholder=\"Doe\"\n                    required\n                    name=\"lastname\"\n                    id=\"lastname\"\n                    autoComplete=\"family-name\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"email\" className=\"block text-sm\">\n                  Email\n                </Label>\n                <Input\n                  type=\"email\"\n                  placeholder=\"youremail@domain.com\"\n                  required\n                  name=\"email\"\n                  id=\"email\"\n                  autoComplete=\"email\"\n                />\n              </div>\n\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"pwd\" className=\"block text-sm\">\n                  Password\n                </Label>\n                <Input\n                  type=\"password\"\n                  required\n                  name=\"pwd\"\n                  id=\"pwd\"\n                  autoComplete=\"new-password\"\n                  placeholder=\"Create a password\"\n                />\n              </div>\n\n              <Button\n                type=\"submit\"\n                className=\"w-full shadow-lg ring-2 shadow-black/20 ring-ring/50\"\n              >\n                Create account\n              </Button>\n            </div>\n\n            <div className=\"my-6 grid grid-cols-[1fr_auto_1fr] items-center gap-3\">\n              <hr className=\"border-dashed\" />\n              <span className=\"text-xs text-muted-foreground\">Or continue with</span>\n              <hr className=\"border-dashed\" />\n            </div>\n\n            <div className=\"grid grid-cols-1 gap-3 sm:grid-cols-2\">\n              <Button type=\"button\" variant=\"outline\">\n                <svg\n                  aria-hidden=\"true\"\n                  data-icon=\"inline-start\"\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  viewBox=\"-3 0 262 262\"\n                  preserveAspectRatio=\"xMidYMid\"\n                  className=\"size-4\"\n                >\n                  <path\n                    d=\"M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027\"\n                    fill=\"#4285F4\"\n                  />\n                  <path\n                    d=\"M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1\"\n                    fill=\"#34A853\"\n                  />\n                  <path\n                    d=\"M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782\"\n                    fill=\"#FBBC05\"\n                  />\n                  <path\n                    d=\"M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251\"\n                    fill=\"#EB4335\"\n                  />\n                </svg>\n                <span>Google</span>\n              </Button>\n\n              <Button type=\"button\" variant=\"outline\">\n                <GitHubIcon aria-hidden=\"true\" data-icon=\"inline-start\" />\n                <span>Github</span>\n              </Button>\n            </div>\n\n            <p className=\"mt-6 text-center text-sm text-muted-foreground\">\n              Have an account?\n              <Button\n                render={<Link href=\"#\" />}\n                nativeButton={false}\n                variant=\"link\"\n                className=\"px-2\"\n              >\n                Sign in\n              </Button>\n            </p>\n          </form>\n        </div>\n\n        {/* Right side pushed to the screen edge */}\n        <div className=\"hidden w-full items-center justify-end md:flex md:h-170\">\n          <div className=\"relative h-full w-full overflow-hidden rounded-l-2xl rounded-r-none\">\n            <div className=\"absolute inset-0 motion-reduce:hidden\">\n              <Shader className=\"h-full\">\n                <Swirl\n                  colorA=\"#7090c5\"\n                  colorB=\"#add7e3\"\n                  colorSpace=\"oklch\"\n                  detail={1.6}\n                  speed={0.5}\n                />\n                <WaveDistortion\n                  angle={20}\n                  edges=\"mirror\"\n                  frequency={1.6}\n                  speed={0.8}\n                  strength={0.1}\n                />\n                <FilmGrain strength={0.15} />\n              </Shader>\n            </div>\n\n            <div className=\"relative z-10 flex h-full flex-col justify-end p-10 text-white\">\n              <h2 className=\"max-w-md text-3xl leading-tight font-semibold\">\n                Build Faster With Hexora\n              </h2>\n\n              <p className=\"mt-3 max-w-sm text-sm text-white/80\">\n                Join thousands of developers and teams using Hexora to manage projects, collaborate,\n                and ship faster.\n              </p>\n\n              <div className=\"mt-6 space-y-2 text-sm text-white/90\">\n                <p>• Organize projects and workflows</p>\n                <p>• Collaborate with your team</p>\n                <p>• Track progress in real time</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "components/blocks/base/sign-up/sign-up-two.tsx"
    },
    {
      "path": "registry/blocks/base/sign-up/sign-up-two/sign-up-two-logo.tsx",
      "content": "import { Hexagon } from 'lucide-react'\n\nimport { cn } from 'cn'\n\nexport function Logo({ className }: { className?: string }) {\n  return (\n    <Hexagon\n      className={cn('size-8 stroke-current stroke-2', className)}\n      aria-hidden\n    />\n  )\n}\n",
      "type": "registry:component",
      "target": "components/blocks/base/sign-up/sign-up-two-logo.tsx"
    }
  ],
  "type": "registry:block"
}