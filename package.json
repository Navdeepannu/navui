{
  "name": "navui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "registry:source": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/registry/generate.mjs",
    "registry:build": "pnpm run registry:source && shadcn build registry.json --output public/r",
    "registry:test": "node --test scripts/registry/*.test.mjs",
    "registry:check": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/registry/generate.mjs --check && shadcn registry validate ./registry.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run registry:test && pnpm run registry:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.34.0",
    "motion": "^13.4.3",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "shaders": "^3.2.470",
    "shiki": "^4.4.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
